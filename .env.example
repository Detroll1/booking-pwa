# ============================================================================
# Frontend (public, bundled into the static build; VITE_* only)
# ============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=local
VITE_DEFAULT_TENANT=graphite-detailing
# Web Push public key (safe to expose). The matching private key stays server-side.
VITE_VAPID_PUBLIC_KEY=

# ============================================================================
# Server-only secrets (Supabase Edge Functions, tenant scripts; NEVER bundled)
# ============================================================================
# Service role key — bypasses RLS. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used by scripts (optional; embedded DB works without it).
DATABASE_URL=

# Access-token signing secret. Booking tokens are HMAC(secret, tenant:booking);
# only sha256(token) is stored. Changing it invalidates existing booking links.
ACCESS_TOKEN_SECRET=

# Helper chatbot is free and rule-based (reads real DB data via server tools);
# no paid LLM or API key is used, so nothing to configure here.

# Web Push / VAPID (optional). Without keys, notifications are marked skipped.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Shared secret for the notifications cron worker endpoint.
CRON_SECRET=
