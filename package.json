{
  "name": "booking-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA online booking for auto service and detailing studios (project 333)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sql": "node scripts/run-sql-tests.mjs",
    "test:e2e": "node scripts/run-e2e-tests.mjs",
