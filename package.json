    "tenant:validate": "node scripts/tenant/validate.mjs",
    "tenant:publish": "node scripts/tenant/publish.mjs",
    "tenant:verify": "node scripts/tenant/verify.mjs",
    "db:start": "node scripts/db/start.mjs",
    "deploy:cf": "npx --yes wrangler pages deploy dist --project-name booking-pwa",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.5",
